dist/
build/

# Large local model artifacts
models/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth

# Raw local acceptance/provider evidence
audit/hermes-groq-*/

# --- Release hygiene additions ---
# Agent/IDE tool scratch (session buffers, local tool state)
.remember/
.claude/
.serena/
.hermes/
*.swp
*~
Thumbs.db

# Anything else under state/ is runtime state; only the README is documentation
state/*
!state/README.md

# Local DBs / caches / editor-adjacent artifacts
*.sqlite
*.sqlite3
*.db
*.bak
*.backup*
.coverage.*
*.egg-info/
.ruff_cache/

# Raw provider/session dumps (keep sanitized summaries as audit/*.md instead)
audit/**/raw/
audit/**/*.session*
audit/**/*.transcript*

# Open-Jev v3 per-decision results: retained as a checksum-verified archive (audit/openjev-v3/EVIDENCE-RETENTION.md), not in Git history
audit/openjev-v3/cal/
audit/openjev-v3/opt/
audit/openjev-v3/final/
audit/openjev-v3/dev/

# Taste Skill working files (draw history, inspection screenshots)
.taste-skill/
