# Names and placeholders ONLY. Never put real credentials in this file.
# Copy to .env (git-ignored) or export in your shell. Most providers authenticate
# through their own CLI login/keychain and need no variable at all.

# --- Provider credentials (only for providers you enable) ---
NVIDIA_API_KEY=            # nvidia_nim background coding route
HERMES_CUSTOM_API_GROQ_COM_API_KEY=   # Hermes custom provider (Groq); consumed by Hermes, not this repo

# --- Agent OS overrides (all optional) ---
# AGENTOS_STATE_DIR=        # default: <repo>/state
# AGENTOS_TELEMETRY_DIR=    # default: <state>/telemetry
# AGENTOS_WORKTREE_ROOT=    # default: <state>/worktrees
# AGENTOS_VAULT=            # SecondBrain path, default: ~/SecondBrain
# AGENTOS_OBSIDIAN_CLI=
# AGENTOS_REPO=             # target repo for hermes-agentos mutation (default: $PWD)
# AGENTOS_VERIFY=           # acceptance command, e.g. "python3 -m pytest -q"
# AGENTOS_TASK_ID=          # pin a task id to resume
# AGENTOS_LIVE=0            # 1 enables live worker tests (uses quota)
