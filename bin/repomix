#!/usr/bin/env bash
# On-demand Repomix (pinned 1.18.1) from the isolated runtime. No PATH change, no MCP.
# Refuses to run as root.
set -euo pipefail
[ "$(id -u)" -ne 0 ] || { echo "repomix: refusing to run as root" >&2; exit 1; }
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BIN="$ROOT/state/runtime/repomix/node_modules/.bin/repomix"
[ -x "$BIN" ] || { echo "repomix: runtime missing; rebuild per docs/capability-rollout.md" >&2; exit 127; }
exec "$BIN" "$@"
