#!/usr/bin/env bash
# Stable entry point for Hermes (and humans) from any working directory.
# Runs the agentos CLI inside ~/agent-stack's uv environment. Refuses to run
# as root.
set -euo pipefail
[ "$(id -u)" -ne 0 ] || { echo "agentos: refusing to run as root" >&2; exit 1; }
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec uv run --quiet --project "$ROOT" agentos "$@"
